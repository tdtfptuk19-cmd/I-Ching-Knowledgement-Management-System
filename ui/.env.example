# Chế độ API: 'mock' (Dùng MSW chạy hoàn toàn phía client) hoặc 'real' (kết nối FastAPI Backend)
VITE_API_MODE=mock

# Base URL cho Backend thật khi VITE_API_MODE=real
# - Khi dev cục bộ: http://localhost:8000/api/v1
# - Khi production: Để trống hoặc đặt URL backend đã deploy (ví dụ: https://my-fastapi.onrender.com/api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Tương thích ngược với cờ VITE_MOCK cũ
VITE_MOCK=true
